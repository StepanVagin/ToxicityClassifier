{
  "model_type": "distilbert",
  "model_name": "distilbert-base-uncased",
  "preprocessing": {
    "max_length": 256,
    "truncation": true,
    "padding": true
  },
  "hyperparameters": {
    "learning_rate": 2e-5,
    "batch_size": 16,
    "epochs": 6,
    "warmup_steps": 500,
    "weight_decay": 0.05
  },
  "training": {
    "device": "auto",
    "show_progress": true,
    "gradient_clip": 1.0,
    "fp16": true,
    "early_stopping_patience": 2,
    "use_pos_weight": true,
    "pos_weight_max": 5,
    "use_llrd": true,
    "llrd_decay": 0.9,
    "head_lr_multiplier": 1.0,
    "dynamic_padding": true,
    "gradient_accumulation_steps": 4,
    "label_decouple_weight": 0.0,
    "label_decouple_correlation_threshold": 0.2
  },
  "tensor_decomposition": {
    "enabled": false
  }
}
